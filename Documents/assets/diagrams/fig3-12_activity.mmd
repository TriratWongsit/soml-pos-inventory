flowchart TD
    ST([เริ่มต้น]) --> A["พนักงานขายบันทึกรายการสินค้าและจำนวน"]
    A --> B["ระบบคำนวณยอดรวมและสร้างเลขที่คำสั่งซื้อ"]
    B --> C["ระบบแสดง QR พร้อมเพย์ตามยอดชำระ"]
    C --> D{"ลูกค้าชำระเงิน<br/>ภายในเวลาที่กำหนด?"}
    D -->|"ไม่"| X["พนักงานยกเลิกคำสั่งซื้อ<br/>status = cancelled"] --> EN([สิ้นสุด])
    D -->|"ใช่"| E["พนักงานยืนยันรับชำระเงิน"]
    E --> F1["ระบบสั่งพิมพ์ใบเสร็จกระดาษ"]
    E --> F2["ระบบผลักคำสั่งซื้อเข้าคิวคลังแบบเรียลไทม์<br/>status = awaiting_dispatch"]
    F1 --> G["ลูกค้าถือใบเสร็จเดินไปจุดรับของ"]
    F2 --> H["พนักงานคลังเห็นคิวและเริ่มจัดเตรียมสินค้าล่วงหน้า"]
    G --> I["พนักงานคลังจับคู่คำสั่งซื้อจากเลขที่ใบเสร็จ"]
    H --> I
    I --> J{"สถานะคำสั่งซื้อ<br/>ยังเป็น รอจ่ายสินค้า?"}
    J -->|"ไม่ (ถูกจ่ายไปแล้ว)"| Y["ระบบปฏิเสธการจ่ายซ้ำ<br/>และแจ้งเตือนพนักงาน"] --> EN
    J -->|"ใช่"| K["ระบบตัดสต็อกแบบอะตอมมิก<br/>และบันทึก stock_movements"]
    K --> L["เปลี่ยนสถานะเป็น ส่งมอบสำเร็จ<br/>และลบออกจากคิว"]
    L --> M["บันทึก Audit Log"]
    M --> N{"สต็อกคงเหลือ<br/>ต่ำกว่าจุดสั่งซื้อเพิ่ม?"}
    N -->|"ใช่"| O["สร้างการแจ้งเตือน In-App<br/>ถึงผู้จัดการ"] --> P
    N -->|"ไม่"| P["อัปเดตแดชบอร์ดปฏิบัติการ"]
    P --> EN
    classDef act fill:#eef3fb,stroke:#33507a,color:#111
    classDef dec fill:#fdf6e3,stroke:#8a6d1a,color:#111
    classDef bad fill:#f9e3e3,stroke:#8a2a2a,color:#111
    class A,B,C,E,F1,F2,G,H,I,K,L,M,O,P act
    class D,J,N dec
    class X,Y bad
