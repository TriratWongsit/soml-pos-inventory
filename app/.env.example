# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับเครื่องที่ติดตั้ง
# ห้าม commit ไฟล์ .env ขึ้น git

# ---------- ฐานข้อมูล ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=soml
DB_NAME_TEST=soml_test

# ---------- เซิร์ฟเวอร์ ----------
PORT=4000
NODE_ENV=development

# ---------- ยืนยันตัวตน ----------
# ต้องเปลี่ยนเป็นค่าสุ่มที่ยาวพอก่อนใช้งานจริง
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# ---------- QR พร้อมเพย์ ----------
# หมายเลขพร้อมเพย์ของร้าน (เบอร์โทรศัพท์หรือเลขประจำตัวผู้เสียภาษี)
PROMPTPAY_ID=

# ---------- บริการพิมพ์ใบเสร็จ ----------
PRINT_SERVICE_URL=http://localhost:4100
PRINT_TIMEOUT_MS=5000
# ต่อผ่านเครือข่าย: tcp://192.168.1.87:9100
# ต่อผ่าน USB ผ่านคิวพิมพ์ของระบบปฏิบัติการ: printer:SOML-Receipt
# โหมดจำลองสำหรับพัฒนาและทดสอบเมื่อยังไม่มีเครื่องพิมพ์จริง
# เขียนสายไบต์ที่จะส่งเครื่องพิมพ์ลงไฟล์ .bin และข้อความที่อ่านได้ลงไฟล์ .txt
# PRINTER_INTERFACE=file://./evidence/printer-simulator
PRINTER_INTERFACE=tcp://192.168.1.87:9100

# ความกว้างกระดาษเป็นจำนวนตัวอักษรต่อบรรทัด  48 = กระดาษ 80 มม. · 32 = กระดาษ 58 มม.
PRINTER_WIDTH_CHARS=48

# ตารางรหัสอักขระของเครื่องพิมพ์  21 คือ TIS-620 ของเครื่องตระกูล Epson
# ถ้าภาษาไทยพิมพ์ออกมาเพี้ยน ให้ดูคู่มือเครื่องพิมพ์แล้วเปลี่ยนเป็นค่าที่ถูกต้อง
PRINTER_CODEPAGE=21

PRINT_SERVICE_PORT=4100

# ---------- เกณฑ์แจ้งเตือน ----------
# คิวค้างนานเกินกี่นาทีจึงแจ้งเตือน (FR-08)
QUEUE_DELAY_THRESHOLD_MINUTES=30
