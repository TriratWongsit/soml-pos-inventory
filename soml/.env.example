# คัดลอกเป็น .env แล้วแก้ค่าให้ตรงเครื่อง — .env ถูก gitignore ไว้ ห้าม commit

# ---------- ฐานข้อมูล (หน่วยติดตั้งที่ 4) ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=soml_new
DB_NAME_TEST=soml_new_test

# ---------- ระบบหลังบ้าน (หน่วยติดตั้งที่ 2) ----------
PORT=4000
NODE_ENV=development
# ต้องเป็นค่าสุ่มยาว ๆ ก่อนใช้งานจริง (2.1.7)
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h

# ---------- QR พร้อมเพย์ ----------
# เบอร์โทรศัพท์หรือเลขประจำตัวผู้เสียภาษีของร้าน
PROMPTPAY_ID=

# ---------- บริการพิมพ์ใบเสร็จ (หน่วยติดตั้งที่ 3) ----------
PRINT_SERVICE_URL=http://localhost:4100
PRINT_SERVICE_PORT=4100
# เครื่องพิมพ์ของร้าน: Epson TM-T82 ต่อ USB → ใช้คิวพิมพ์ของระบบปฏิบัติการ  printer:SOML-Receipt
# ผ่านเครือข่าย: tcp://192.168.1.87:9100 · ไม่มีเครื่องพิมพ์: file://./printer-output
PRINTER_INTERFACE=file://./printer-output
# TM-T82 กระดาษ 80 มม. = 48 ตัวอักษร · code page 21 = Thai Character Code 11
PRINTER_WIDTH_CHARS=48
PRINTER_CODEPAGE=21
SHOP_NAME=ร้านอำพรคอนกรีต

# ---------- เกณฑ์แจ้งเตือน (FR-08) ----------
QUEUE_DELAY_THRESHOLD_MINUTES=30

# ---------- รหัสผ่านเริ่มต้นตอน seed ผู้ใช้ ----------
SEED_PASSWORD=Soml@2569
